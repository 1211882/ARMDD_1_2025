              description="Joins additional columns to the data flow by looking up values in a table. For example, join to the 'employee id' column the employees table to get 'hire date' and 'employee name'. We recommend this transformation when the lookup table can fit into memory."
              name="Lookup ExchangeRate"
              usesDispositions="true"
              version="6">
              <properties>
                <property
                  dataType="System.String"
                  description="Specifies the SQL statement that generates the lookup table."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    d.Year,
    d.Month,
    fcr.SourceCurrency,
    fcr.ExchangeRate
FROM dbo.FactCurrencyRate fcr
JOIN dbo.DimDate d
    ON fcr.DateKey = d.DateKey
JOIN dbo.DimCurrency dc
    ON fcr.TargetCurrency = dc.CurrencyKey
WHERE dc.CurrencyID = 'EUR';</property>
                <property
                  dataType="System.String"
                  description="Specifies a SQL statement that uses parameters to generate the lookup table."
                  expressionType="Notify"
                  name="SqlCommandParam"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">select * from (SELECT
    d.Year,
    d.Month,
    fcr.SourceCurrency,
    fcr.ExchangeRate
FROM dbo.FactCurrencyRate fcr
JOIN dbo.DimDate d
    ON fcr.DateKey = d.DateKey
JOIN dbo.DimCurrency dc
    ON fcr.TargetCurrency = dc.CurrencyKey
WHERE dc.CurrencyID = 'EUR';) [refTable]
where [refTable].[Year] = ? and [refTable].[Month] = ? and [refTable].[SourceCurrency] = ?</property>
