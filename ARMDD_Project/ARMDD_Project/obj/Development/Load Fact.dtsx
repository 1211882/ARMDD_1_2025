            <component
              refId="Package\Load FactOrderLine\Orders &amp; OrderLines"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Orders &amp; OrderLines"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[dbo].[stg_OrdersLines]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    ol.OrderLineID,
    ol.OrderID,

    o.CustomerID,
    o.SiteID,
    CONVERT(VARCHAR(10), o.OrderDate, 23) AS OrderDate_Str,
    o.CurrencyID,

    c.Code AS CountryCode,

    o.Address,
    o.City,
    o.State,
    o.Zip,

    ol.ProductID,
    ol.SizeID,

    ol.Quantity,
    ol.LineTotal,

    SUM(ol.LineTotal) OVER (PARTITION BY ol.OrderID) 
        AS TotalLineValue_Local,

    old.Discount,
    old.PromotionDiscount,

    o.ShippingCost
FROM dbo.stg_OrdersLines ol
JOIN dbo.stg_Orders o
    ON ol.OrderID = o.OrderID
JOIN dbo.stg_Countries c
    ON o.CountryID = c.CountryID
LEFT JOIN dbo.stg_OrdersLinesDetails old
    ON ol.OrderLineID = old.OrderLineID;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
                  description="Specifies the mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">2</property>
                <property
                  dataType="System.String"
                  description="The mappings between the parameters in the SQL command and variables."
                  name="ParameterMapping"></property>
              </properties>
              <connections>
                <connection
                  refId="Package\Load FactOrderLine\Orders &amp; OrderLines.Connections[OleDbConnection]"
                  connectionManagerID="{536C301B-46DC-4D7D-95FB-320DF63F0796}:external"
                  connectionManagerRefId="Project.ConnectionManagers[StagingArea]"
                  description="The OLE DB runtime connection used to access the database."
                  name="OleDbConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\Load FactOrderLine\Orders &amp; OrderLines.Outputs[OLE DB Source Output]"
                  name="OLE DB Source Output">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Load FactOrderLine\Orders &amp; OrderLines.Outputs[OLE DB Source Output].Columns[OrderLineID]"
                      dataType="i4"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\Load FactOrderLine\Orders &amp; OrderLines.Outputs[OLE DB Source Output].ExternalColumns[OrderLineID]"
                      lineageId="Package\Load FactOrderLine\Orders &amp; OrderLines.Outputs[OLE DB Source Output].Columns[OrderLineID]"
                      name="OrderLineID"
